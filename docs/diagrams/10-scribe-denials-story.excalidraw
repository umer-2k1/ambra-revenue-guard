      "link": null,
      "locked": false
    },
    {
      "id": "t-step2",
      "type": "text",
      "x": 380,
      "y": 616,
      "width": 260.4,
      "height": 87.5,
      "angle": 0,
      "strokeColor": "#3a2f2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
