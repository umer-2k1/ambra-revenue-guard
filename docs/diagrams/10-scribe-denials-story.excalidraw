      "type": "text",
      "x": 66,
      "y": 572,
      "width": 927.0,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#3a2f2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
