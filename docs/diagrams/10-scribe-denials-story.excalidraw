      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1. Learn\n\nWe read every resolved denial\nand work out the real reason\nit was denied.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Learn\n\nWe read every resolved denial\nand work out the real reason\nit was denied.",
      "lineHeight": 1.25,
      "baseline": 12
    },
    {
