      "versionNonce": 1933120638,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2. Remember\n\nWe save each one as a simple\nprevention rule - so the system\ngets smarter with every denial.",
      "fontSize": 14,
