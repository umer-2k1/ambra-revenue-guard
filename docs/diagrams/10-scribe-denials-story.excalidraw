      "versionNonce": 869242196,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "We take the resolved denials you already have, and turn them into something that prevents the next one.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We take the resolved denials you already have, and turn them into something that prevents the next one.",
      "lineHeight": 1.25,
      "baseline": 13
    },
    {
