# ─────────────────────────────────────────────────────────────
#  Ambra — Denial-to-Prevention Feedback Loop
#  Copy this file to `.env` and fill in your keys.
# ─────────────────────────────────────────────────────────────

# ── LLM provider: deepseek | groq ────────────────────────────
# Both are OpenAI-compatible, so switching is just this one value.
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Embedding provider: gemini | groq ────────────────────────
# Both produce 768-dim vectors, matching the Qdrant collections.
EMBEDDING_PROVIDER=gemini

GEMINI_API_KEY=your-gemini-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001   # Gemini free tier

GROQ_EMBEDDING_MODEL=nomic-embed-text-v1_5    # Groq embeddings (768-dim)

EMBEDDING_DIM=768

# ── Paths (optional — defaults shown) ────────────────────────
DATABASE_PATH=./data/ambra_demo.db
QDRANT_PATH=./data/qdrant_db

# ── Database: Postgres (optional) ────────────────────────────
# Set DATABASE_URL to use Postgres (e.g. Neon) instead of local SQLite.
# Leave blank to use SQLite at DATABASE_PATH (zero-setup local dev).
# DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require

# ── CORS (backend) ───────────────────────────────────────────
# Comma-separated allowed browser origins — set to your deployed frontend URL.
CORS_ORIGINS=http://localhost:5173

# ── Vector store: Qdrant Cloud (optional) ────────────────────
# Leave QDRANT_URL blank to use the embedded local store at QDRANT_PATH.
# Set both to use Qdrant Cloud / any Qdrant server (free 1 GB tier at cloud.qdrant.io).
# QDRANT_URL=https://xxxxxxxx-xxxx.us-east-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key
